
{
  "manifest_version": 3,
  "name": "MailMind AI",
  "version": "1.0.0",
  "description": "AI Email Classification and Response Assistant",

  "permissions": [
    "sidePanel",
    "activeTab",
    "identity"
  ],

  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "http://127.0.0.1:8000/*"
  ],

  "oauth2": {
    "client_id": "469815894902-b5d0mjm2mkdvlpp9b4r6k9oiq3r8hupi.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Open MailMind AI"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
